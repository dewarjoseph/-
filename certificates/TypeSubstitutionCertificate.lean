    let mk := fun (vax vp vq : Int) => setComp (setComp (setComp (0,0,0) ax vax) p vp) q vq
    let finePanels := [mk (X-1) (comp b p) (comp b q), mk (X-1) (comp b p) (comp b q + 1),
                       mk (X-1) (comp b p + 1) (comp b q), mk (X-1) (comp b p + 1) (comp b q + 1)]
    let idxP := finePanels.map (fun fc => idxOfKey pk (panelKey om fc ax))
    let plaqs : List (V3 × Nat × Nat) :=
      [(mk (X-1) (comp b p) (comp b q), ax, q), (mk (X-1) (comp b p + 1) (comp b q), ax, q),
       (mk (X-1) (comp b p) (comp b q), ax, p), (mk (X-1) (comp b p) (comp b q + 1), ax, p)]
    let idxQ := plaqs.map (fun x => idxOfKey qk (plaqKey om x.1 (min x.2.1 x.2.2) (max x.2.1 x.2.2)))
    sameMultiset idxP certP && sameMultiset idxQ certQ

/-- The two fine plaquettes along the inflated edge of plaquette representative `t` have the certified types. -/
def checkPlaqImage (qk : List (List Int)) (t : Nat) : Bool :=
  match plaqReps.getD t ([], (0,0,0), 0, 0), plaqImg.getD t [] with
  | r, cert =>
    if r.1.length == 0 then false else
    let om := ownerArith r.1
    let c := r.2.1
    let i := r.2.2.1
    let j := r.2.2.2
    let k := 3 - i - j
    let idx := [0, 1].map (fun s => idxOfKey qk (plaqKey om (vadd (vadd (vadd (vscale 2 c) (e i)) (e j)) (vscale s (e k))) i j))
    sameMultiset idx cert

def root : Pose := (I3, (0,0,0))
def T1 : List Pose := inflate root
def ownerL1 : Owner := ownerArith [root]
def ownerL2 : Owner := ownerArith T1
def region (n : Nat) : List V3 :=
  (List.range n).foldl (fun acc (x : Nat) => acc ++ (List.range n).foldl (fun acc2 (y : Nat) =>
    acc2 ++ (List.range n).map (fun (z : Nat) => ((Int.ofNat x, Int.ofNat y, Int.ofNat z) : V3))) []) []
def panelIdxList (cubes : List V3) (om : Owner) (pk : List (List Int)) : List Nat :=
  cubes.foldl (fun acc c => acc ++ ([0,1,2].filterMap (fun ax =>
    match om c, om (vadd c (e ax)) with
    | some p, some p2 => if p2 == p then none else some (idxOfKey pk (panelKey om c ax))
    | _, _ => none))) []
def plaqIdxList (cubes : List V3) (om : Owner) (qk : List (List Int)) : List Nat :=
  cubes.foldl (fun acc c => acc ++ ([(0,1),(0,2),(1,2)].filterMap (fun ij =>
    if isInterTilePlaquette om c ij.1 ij.2 then some (idxOfKey qk (plaqKey om c ij.1 ij.2)) else none))) []
def countsOf (idx : List Nat) (n : Nat) : List Int := (List.range n).map (fun i => (idx.count i : Int))
def enumClassCounts (cubes : List V3) (om : Owner) : List Int :=
  let cls := cubes.foldl (fun acc c => acc ++ ([(0,1),(0,2),(1,2)].filterMap (fun ij =>
    if isInterTilePlaquette om c ij.1 ij.2 then some (classOfQ (plaqHol om c ij.1 ij.2)) else none))) []
  (List.range 5).map (fun c => (cls.count c : Int))
/-- Every tile occurring in a representative or in T1: its children's cubes are the rigid image of the standard ones. -/
def allRepTiles : List Pose := (panelReps.foldl (fun acc r => acc ++ r.1) []) ++ (plaqReps.foldl (fun acc r => acc ++ r.1) []) ++ T1 ++ [root]
def equivariantAt (p : Pose) : Bool :=
  (List.range 8).all (fun i => cubesOf (childPoseOf p i) == (cubesOf (childPoseOf root i)).map (motion p))
def standardL1Ok : Bool :=
  let om := ownerMapOf T1
  om.length == 56 && (om.map (·.1)).eraseDups.length == 56 &&
  om.all (fun x => inRegion1 x.1 && (T1.getD (idx1 x.1) root == x.2)) &&
  ((region 4).filter inRegion1).length == 56

set_option maxRecDepth 100000 in
theorem types_distinct : panelKeys.eraseDups.length = NP ∧ plaqKeys.eraseDups.length = NQ := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem panel_images_certified : (List.range NP).all (checkPanelImage panelKeys plaqKeys) = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem plaquette_images_certified : (List.range NQ).all (checkPlaqImage plaqKeys) = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem classes_certified : plaqClasses = plaqClassCert := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem standard_level1_certified : standardL1Ok = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem equivariance_certified : allRepTiles.all equivariantAt = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem seed_certified :
    countsOf (panelIdxList (region 4) ownerL1 panelKeys) NP = seedPCert ∧
    countsOf (plaqIdxList (region 4) ownerL1 plaqKeys) NQ = seedQCert ∧
    (panelIdxList (region 4) ownerL1 panelKeys).length = 48 ∧ (plaqIdxList (region 4) ownerL1 plaqKeys).length = 60 := by
  decide +kernel

/-! ### The type-substitution operator and the recursion v_{m+1} = S v_m + 8^m f (indices: panels 0..NP-1, plaquettes NP..N-1) -/
def imgOf (c : Nat) : List Nat :=
  if c < NP then panelImgP.getD c [] ++ (panelImgQ.getD c []).map (· + NP)
  else (plaqImg.getD (c - NP) []).map (· + NP)
def Sentry (r c : Nat) : Int := ((imgOf c).count r : Int)
def applyS (x : Nat → Int) (r : Nat) : Int := (List.range N).foldl (fun acc c => acc + Sentry r c * x c) 0
def fvec : Nat → Int := fun r => if r < NP then seedPCert.getD r 0 else seedQCert.getD (r - NP) 0
/-- `useq j` is the recursion vector v_{j+1}: `useq 0 = f = v_1`, `useq (j+1) = S (useq j) + 8^(j+1) f`. -/
def useq : Nat → Nat → Int
  | 0 => fvec
  | j+1 => fun r => applyS (useq j) r + (8 : Int) ^ (j+1) * fvec r
def W8 : Nat → Int := fun r => W8L.getD r 0
def W4 : Nat → Int := fun r => W4L.getD r 0
def W2 : Nat → Int := fun r => W2L.getD r 0
def W1 : Nat → Int := fun r => W1L.getD r 0
/-- Closed form for D v_{j+1}. -/
def CF (j : Nat) (r : Nat) : Int :=
  (8 : Int) ^ (j+1) * W8 r + (4 : Int) ^ (j+1) * W4 r + (2 : Int) ^ (j+1) * W2 r + W1 r
/-- Certified values of v_2 = useq 1 and v_3 = useq 2 (re-verified below by one application of S each). -/
def U1 : Nat → Int := fun r => U1L.getD r 0
def U2 : Nat → Int := fun r => U2L.getD r 0

/-! ### (F4): level-2 geometry agrees with the recursion -/
def recursionClassCounts (x : Nat → Int) : List Int :=
  (List.range 5).map (fun cls => (List.range NQ).foldl (fun acc q => acc + (if plaqClassCert.getD q 5 == cls then x (NP + q) else 0)) 0)

set_option maxRecDepth 100000 in
theorem level1_geometry_matches_recursion : enumClassCounts (region 4) ownerL1 = recursionClassCounts fvec := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem level2_geometry_matches_recursion : enumClassCounts (region 8) ownerL2 = recursionClassCounts U1 := by
  decide +kernel

/-! ### (F5): eigen-certificate and base case -/
set_option maxRecDepth 100000 in
theorem eigen_check :
    (List.range N).all (fun r => (applyS W8 r + D * fvec r == 8 * W8 r) && (applyS W4 r == 4 * W4 r) &&
                                 (applyS W2 r == 2 * W2 r) && (applyS W1 r == W1 r)) = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem u1_check : (List.range N).all (fun r => applyS fvec r + 8 * fvec r == U1 r) = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem u2_check : (List.range N).all (fun r => applyS U1 r + 64 * fvec r == U2 r) = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem base_check : (List.range N).all (fun r => D * U2 r == CF 2 r) = true := by
  decide +kernel

/-! ### Elementary fold lemmas (the only hand proofs) -/
theorem foldl_add_split (l : List Nat) (g h : Nat → Int) : ∀ (a b : Int),
    l.foldl (fun acc c => acc + (g c + h c)) (a + b) =
      l.foldl (fun acc c => acc + g c) a + l.foldl (fun acc c => acc + h c) b := by
  induction l with
  | nil => intro a b; rfl
  | cons c l ih =>
    intro a b
    simp only [List.foldl_cons]
    rw [show a + b + (g c + h c) = (a + g c) + (b + h c) by omega]
    exact ih (a + g c) (b + h c)

theorem foldl_smul (l : List Nat) (g : Nat → Int) (k : Int) : ∀ (a : Int),
    l.foldl (fun acc c => acc + k * g c) (k * a) = k * l.foldl (fun acc c => acc + g c) a := by
  induction l with
  | nil => intro a; rfl
  | cons c l ih =>
    intro a
    simp only [List.foldl_cons]
    rw [← Int.mul_add]
    exact ih (a + g c)

theorem foldl_congr_mem (l : List Nat) (g h : Nat → Int) (hgh : ∀ c ∈ l, g c = h c) : ∀ (a : Int),
    l.foldl (fun acc c => acc + g c) a = l.foldl (fun acc c => acc + h c) a := by
  induction l with
  | nil => intro a; rfl
  | cons c l ih =>
    intro a
    simp only [List.foldl_cons]
    rw [hgh c (by simp)]
    exact ih (fun x hx => hgh x (by simp [hx])) (a + h c)

theorem applyS_add (x y : Nat → Int) (r : Nat) :
    applyS (fun c => x c + y c) r = applyS x r + applyS y r := by
  unfold applyS
  have h : (fun (acc : Int) (c : Nat) => acc + Sentry r c * (x c + y c)) =
           (fun (acc : Int) (c : Nat) => acc + (Sentry r c * x c + Sentry r c * y c)) := by
    funext acc c; rw [Int.mul_add]
  rw [h]
  have := foldl_add_split (List.range N) (fun c => Sentry r c * x c) (fun c => Sentry r c * y c) 0 0
  simpa using this

theorem applyS_smul (x : Nat → Int) (k : Int) (r : Nat) :
    applyS (fun c => k * x c) r = k * applyS x r := by
  unfold applyS
  have h : (fun (acc : Int) (c : Nat) => acc + Sentry r c * (k * x c)) =
           (fun (acc : Int) (c : Nat) => acc + k * (Sentry r c * x c)) := by
    funext acc c; rw [Int.mul_left_comm]
  rw [h]
  have := foldl_smul (List.range N) (fun c => Sentry r c * x c) k 0
  simpa using this

theorem applyS_congr (x y : Nat → Int) (hxy : ∀ c, c < N → x c = y c) (r : Nat) :
    applyS x r = applyS y r := by
  unfold applyS
  exact foldl_congr_mem (List.range N) (fun c => Sentry r c * x c) (fun c => Sentry r c * y c)
    (fun c hc => by rw [hxy c (List.mem_range.mp hc)]) 0

/-! ### (F6): the exact closed form for all levels m = j+1 >= 3 -/
def closedFormHolds (j : Nat) : Prop := ∀ r, r < N → D * useq j r = CF j r

theorem eigen_identities (r : Nat) (hr : r < N) :
    applyS W8 r + D * fvec r = 8 * W8 r ∧ applyS W4 r = 4 * W4 r ∧
    applyS W2 r = 2 * W2 r ∧ applyS W1 r = W1 r := by
  have h := (List.all_eq_true.mp eigen_check) r (List.mem_range.mpr hr)
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  exact ⟨h.1.1.1, h.1.1.2, h.1.2, h.2⟩

theorem useq1_eq (r : Nat) (hr : r < N) : useq 1 r = U1 r := by
  have h := (List.all_eq_true.mp u1_check) r (List.mem_range.mpr hr)
  simp only [beq_iff_eq] at h
  show applyS (useq 0) r + (8 : Int) ^ (0 + 1) * fvec r = U1 r
  rw [show (8 : Int) ^ (0 + 1) = 8 by decide]
  exact h

theorem useq2_eq (r : Nat) (hr : r < N) : useq 2 r = U2 r := by
  have h := (List.all_eq_true.mp u2_check) r (List.mem_range.mpr hr)
  simp only [beq_iff_eq] at h
  show applyS (useq 1) r + (8 : Int) ^ (1 + 1) * fvec r = U2 r
  rw [show (8 : Int) ^ (1 + 1) = 64 by decide, applyS_congr (useq 1) U1 (fun c hc => useq1_eq c hc) r]
  exact h

theorem base_case : closedFormHolds 2 := by
  intro r hr
  have h := (List.all_eq_true.mp base_check) r (List.mem_range.mpr hr)
  simp only [beq_iff_eq] at h
  rw [useq2_eq r hr]
  exact h

theorem step_case (j : Nat) (ih : closedFormHolds j) : closedFormHolds (j+1) := by
  intro r hr
  have hu : useq (j+1) r = applyS (useq j) r + (8 : Int) ^ (j+1) * fvec r := rfl
  have h1 : D * applyS (useq j) r = applyS (fun c => D * useq j c) r := (applyS_smul (useq j) D r).symm
  have h2 : applyS (fun c => D * useq j c) r = applyS (CF j) r :=
    applyS_congr _ _ (fun c hc => ih c hc) r
  have e1 : CF j = fun c => ((fun c => (8 : Int) ^ (j+1) * W8 c + (4 : Int) ^ (j+1) * W4 c) c +
                             (fun c => (2 : Int) ^ (j+1) * W2 c) c) + (fun c => W1 c) c := by
    funext c; rfl
  have e2 : (fun c => (8 : Int) ^ (j+1) * W8 c + (4 : Int) ^ (j+1) * W4 c) =
            fun c => (fun c => (8 : Int) ^ (j+1) * W8 c) c + (fun c => (4 : Int) ^ (j+1) * W4 c) c := by
    funext c; rfl
  have h3 : applyS (CF j) r = (8 : Int) ^ (j+1) * applyS W8 r + (4 : Int) ^ (j+1) * applyS W4 r +
                               (2 : Int) ^ (j+1) * applyS W2 r + applyS W1 r := by
    rw [e1, applyS_add, applyS_add, e2, applyS_add, applyS_smul, applyS_smul, applyS_smul]
  obtain ⟨g8, g4, g2, g1⟩ := eigen_identities r hr
  have g8' : applyS W8 r = 8 * W8 r - D * fvec r := by omega
  rw [hu, Int.mul_add, h1, h2, h3, g8', g4, g2, g1]
  unfold CF
  rw [Int.pow_succ (8 : Int) (j+1), Int.pow_succ (4 : Int) (j+1), Int.pow_succ (2 : Int) (j+1)]
  rw [Int.mul_sub, Int.mul_left_comm D ((8 : Int) ^ (j+1)) (fvec r)]
  simp only [Int.mul_assoc]
  generalize (8 : Int) ^ (j+1) * (8 * W8 r) = X1 at *
  generalize (8 : Int) ^ (j+1) * (D * fvec r) = X2 at *
  generalize (4 : Int) ^ (j+1) * (4 * W4 r) = X3 at *
  generalize (2 : Int) ^ (j+1) * (2 * W2 r) = X4 at *
  omega

theorem closed_form_all : ∀ j, 2 ≤ j → closedFormHolds j := by
  intro j
  induction j with
  | zero => intro h; omega
  | succ n ih =>
    intro h
    cases Nat.lt_or_ge n 2 with
    | inl hlt =>
      have : n + 1 = 2 := by omega
      rw [this]; exact base_case
    | inr hge => exact step_case n (ih hge)

/-! ### (F7): class counts, the exact finite-size law, and the limiting frequencies -/
def indicator (cls q : Nat) : Int := if plaqClassCert.getD q 5 == cls then 1 else 0
def wsum (w : Nat → Int) (x : Nat → Int) : Int := (List.range NQ).foldl (fun acc q => acc + w q * x (NP + q)) 0
def classCount (cls : Nat) (x : Nat → Int) : Int := wsum (indicator cls) x
def plaqTotal (x : Nat → Int) : Int := wsum (fun _ => 1) x

theorem wsum_add (w x y : Nat → Int) : wsum w (fun c => x c + y c) = wsum w x + wsum w y := by
  unfold wsum
  have h : (fun (acc : Int) (q : Nat) => acc + w q * (x (NP + q) + y (NP + q))) =
           (fun (acc : Int) (q : Nat) => acc + (w q * x (NP + q) + w q * y (NP + q))) := by
    funext acc q; rw [Int.mul_add]
  rw [h]
  have := foldl_add_split (List.range NQ) (fun q => w q * x (NP + q)) (fun q => w q * y (NP + q)) 0 0
  simpa using this

theorem wsum_smul (w x : Nat → Int) (k : Int) : wsum w (fun c => k * x c) = k * wsum w x := by
  unfold wsum
  have h : (fun (acc : Int) (q : Nat) => acc + w q * (k * x (NP + q))) =
           (fun (acc : Int) (q : Nat) => acc + k * (w q * x (NP + q))) := by
    funext acc q; rw [Int.mul_left_comm]
  rw [h]
  have := foldl_smul (List.range NQ) (fun q => w q * x (NP + q)) k 0
  simpa using this

theorem wsum_congr (w x y : Nat → Int) (hxy : ∀ c, c < N → x c = y c) : wsum w x = wsum w y := by
  unfold wsum
  exact foldl_congr_mem (List.range NQ) (fun q => w q * x (NP + q)) (fun q => w q * y (NP + q))
    (fun q hq => by
      have hq' := List.mem_range.mp hq
      rw [hxy (NP + q) (by unfold N NP NQ at *; omega)]) 0

/-- THEOREM. For every level m = j+1 >= 3 and every weight w, the weighted plaquette sum of the recursion obeys the
    exact finite-size law  D * Σ w = 8^m (w·W8) + 4^m (w·W4) + 2^m (w·W2) + (w·W1). -/
theorem wsum_closed_form (w : Nat → Int) (j : Nat) (hj : 2 ≤ j) :
    D * wsum w (useq j) = (8 : Int) ^ (j+1) * wsum w W8 + (4 : Int) ^ (j+1) * wsum w W4 +
                          (2 : Int) ^ (j+1) * wsum w W2 + wsum w W1 := by
  have hcf := closed_form_all j hj
  have e1 : CF j = fun c => ((fun c => (8 : Int) ^ (j+1) * W8 c + (4 : Int) ^ (j+1) * W4 c) c +
                             (fun c => (2 : Int) ^ (j+1) * W2 c) c) + (fun c => W1 c) c := by
    funext c; rfl
  have e2 : (fun c => (8 : Int) ^ (j+1) * W8 c + (4 : Int) ^ (j+1) * W4 c) =
            fun c => (fun c => (8 : Int) ^ (j+1) * W8 c) c + (fun c => (4 : Int) ^ (j+1) * W4 c) c := by
    funext c; rfl
  rw [← wsum_smul, wsum_congr w _ (CF j) hcf, e1, wsum_add, wsum_add, e2, wsum_add, wsum_smul, wsum_smul, wsum_smul]

theorem class_counts_closed_form (cls j : Nat) (hj : 2 ≤ j) :
    D * classCount cls (useq j) = (8 : Int) ^ (j+1) * classCount cls W8 + (4 : Int) ^ (j+1) * classCount cls W4 +
                                  (2 : Int) ^ (j+1) * classCount cls W2 + classCount cls W1 :=
  wsum_closed_form (indicator cls) j hj

theorem total_closed_form (j : Nat) (hj : 2 ≤ j) :
    D * plaqTotal (useq j) = (8 : Int) ^ (j+1) * plaqTotal W8 + (4 : Int) ^ (j+1) * plaqTotal W4 +
                             (2 : Int) ^ (j+1) * plaqTotal W2 + plaqTotal W1 :=
  wsum_closed_form (fun _ => 1) j hj

set_option maxRecDepth 100000 in
/-- The leading coefficients: N_m ~ 18·8^m - 24·4^m + 6·2^m and the limiting class frequencies
    19/36, 13/144, 1/9, 23/144, 1/9. -/
theorem limit_frequencies :
    plaqTotal W8 = 18 * D ∧ plaqTotal W4 = -24 * D ∧ plaqTotal W2 = 6 * D ∧ plaqTotal W1 = 0 ∧
    36 * classCount 0 W8 = 19 * plaqTotal W8 ∧ 144 * classCount 1 W8 = 13 * plaqTotal W8 ∧
    9 * classCount 2 W8 = plaqTotal W8 ∧ 144 * classCount 3 W8 = 23 * plaqTotal W8 ∧
    9 * classCount 4 W8 = plaqTotal W8 := by
  decide +kernel

